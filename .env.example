# --- Публичный адрес ---
PUBLIC_DOMAIN=connect.indolight.com

# --- База ---
PGHOST=postgres
PGPORT=5432
PGUSER=messenger
PGPASSWORD=CHANGE_ME
PGDATABASE=messenger

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- amoCRM: приватная интеграция (шаг 1 Анатолия) ---
AMO_SUBDOMAIN=
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://connect.indolight.com/amocrm/callback

# --- amoCRM: Chat API (придёт от техподдержки, шаг 2) ---
# scope_id выдаётся при подключении канала к аккаунту (scripts/connect-channel.ts)

# --- Telegram-алерты ---
# Ключи с my.telegram.org для подключения аккаунтов Телеграма
TG_API_ID=
TG_API_HASH=

TG_BOT_TOKEN=
TG_ALERT_CHAT_ID=

# --- Admin API ---
ADMIN_API_KEY=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_CORS_ORIGIN=https://*.lovable.app,https://*.lovableproject.com

# --- Поведение ---
NEW_CHAT_DELAY_MIN_MS=2000
NEW_CHAT_DELAY_MAX_MS=8000
REPLY_DELAY_MIN_MS=300
REPLY_DELAY_MAX_MS=1500

MAX_BRIDGE_URL=http://max-bridge:8090
# Общий пароль между сервисом и службой MAX, любой длинный набор символов
BRIDGE_SECRET=CHANGE_ME

MEDIA_DIR=/app/media
MEDIA_TTL_DAYS=180
LOG_LEVEL=info
