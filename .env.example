# --- Публичный адрес ---
PUBLIC_DOMAIN=connect.indolight.com

# --- База ---
PGHOST=postgres
PGPORT=5432
PGUSER=messenger
PGPASSWORD=CHANGE_ME
PGDATABASE=messenger

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- amoCRM: приватная интеграция (шаг 1 Анатолия) ---
AMO_SUBDOMAIN=
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=https://connect.indolight.com/amocrm/callback

# --- amoCRM: Chat API (придёт от техподдержки, шаг 2) ---
AMO_CHAT_CHANNEL_ID=
AMO_CHAT_SECRET_KEY=

# --- Telegram-алерты ---
TG_BOT_TOKEN=
TG_ALERT_CHAT_ID=

# --- Admin API ---
ADMIN_API_KEY=CHANGE_ME
ADMIN_CORS_ORIGIN=https://*.lovable.app

# --- Поведение ---
MEDIA_DIR=/app/media
MEDIA_TTL_DAYS=180
LOG_LEVEL=info
